# ── Server ────────────────────────────────────────────────────────────────────
PORT=3979
NODE_ENV=development
COMPANY_NAME=Amertron Corporation

# ── Nextcloud Talk ────────────────────────────────────────────────────────────
# Base URL of your Nextcloud server (no trailing slash)
TALK_SERVER_URL=https://amertron-nextcloud-test.dedyn.io
# Shared secret printed by `occ talk:bot:install` (SECRET_ prefix = treated as secret)
SECRET_TALK_SECRET=
TALK_WEBHOOK_PATH=/api/talk/webhook
# true = only answer when @Ami is mentioned; false = answer every chat message
TALK_REQUIRE_MENTION=false

# ── AI provider (same keys as the Teams Ami) ─────────────────────────────────
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Extra sensitive phrases (comma-separated), merged with the built-in list
SENSITIVE_TOPICS=

# Max image size Ami will download & analyze (images also always need @Ami mention)
MAX_IMAGE_SIZE_MB=10
# Nextcloud admin(s) — comma-separated if multiple (e.g. "admin,alice,bob").
# Anyone in the Nextcloud `admin` group is also auto-recognized (via provisioning API),
# so a group-admin like `helpdesk-admin` in `admin` group works without listing here.
# Must be members of the room for WebDAV image fallback and for $approve etc.
TALK_ADMIN_USER=
SECRET_TALK_ADMIN_PASSWORD=

# ── Conversation tuning ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=60000
MAX_REQUESTS_PER_WINDOW=10
SESSION_TIMEOUT=120000
MAX_HISTORY_TURNS=20
